APP_NAME=MB16 Showroom
APP_ENV=development
DATABASE_URL=postgresql+psycopg://showroom:showroom@db:5432/showroom
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
AUTH_MAX_AGE_SECONDS=86400
APP_TIMEZONE=Europe/Moscow

# Debug only. Production ignores X-Debug-User-Id.
DEBUG_TELEGRAM_USER_ID=1001
DEBUG_TELEGRAM_USERNAME=demo_client
DEBUG_TELEGRAM_NAME=Demo Client
DEBUG_ADMIN_USER_ID=9001
DEBUG_ADMIN_USERNAME=demo_admin
DEBUG_ADMIN_NAME=Demo Admin

# local | s3
STORAGE_BACKEND=local
UPLOAD_DIR=./data/uploads
PUBLIC_BASE_URL=

# For Timeweb Object Storage / any S3-compatible storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=ru-1
S3_PUBLIC_BASE_URL=

MAX_IMAGE_MB=10
MAX_VIDEO_MB=80
